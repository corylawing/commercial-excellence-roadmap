{
  "id": "./",
  "name": "Chat to Salesforce",
  "short_name": "Chat to SF",
  "description": "Save WhatsApp conversations to Salesforce as interactions, on the right doctor and practice.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f6fb",
  "theme_color": "#5b5bd6",
  "lang": "en",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["text/plain", ".txt", "application/zip", ".zip", "image/*", "audio/*", "video/*", "application/pdf", "application/octet-stream"]
        }
      ]
    }
  }
}
